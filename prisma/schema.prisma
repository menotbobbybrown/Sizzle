generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── NextAuth Models ────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(USER)

  accounts Account[]
  sessions Session[]

  // Creator workspace membership
  workspaces WorkspaceMember[]

  // Customer relations
  orders        Order[]
  enrollments   Enrollment[]
  reviews       Review[]
  notifications Notification[]
  memberSubscriptions MemberSubscription[]
  affiliateLinks AffiliateLink[]

  // Onboarding state
  onboarding OnboardingState?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  USER
  ADMIN
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Workspace (renamed from Tenant) ─────────────────────────────────────────

model Workspace {
  id        String  @id @default(cuid())
  name      String
  handle    String  @unique // The @handle for the storefront URL
  domain    String? @unique
  logoUrl   String?
  bannerUrl String?
  bio       String? @db.Text

  // Stripe Connect
  stripeAccountId     String? @unique
  stripeAccountStatus String? @default("disconnected")

  // SaaS subscription (flat $5/mo)
  plan                 WorkspacePlan @default(TRIALING)
  stripeSubscriptionId String?       @unique
  trialEndsAt          DateTime?

  members           WorkspaceMember[]
  products          Product[]
  orders            Order[]
  storefront        StorefrontTheme?
  subscribers       Subscriber[]
  campaigns         Campaign[]
  handleReservation HandleReservation? @relation("HandleToWorkspace")

  // Analytics aggregates
  analytics AnalyticsDaily[]
  
  recentSales RecentSale[]
  socialConnections SocialConnection[]
  affiliateLinks AffiliateLink[]
  memberSubscriptions MemberSubscription[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  discountCodes DiscountCode[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspacePlan {
  FREE
  CREATOR
  PRO
  BUSINESS
  TRIALING
  PAST_DUE
  CANCELED
}

// ─── Onboarding ──────────────────────────────────────────────────────────────

model OnboardingState {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  step        OnboardingStep @default(ACCOUNT)
  completedAt DateTime?

  // Step 1: Account
  accountSkipped  Boolean @default(false)
  // Step 2: Handle
  handleSkipped   Boolean @default(false)
  // Step 3: Payout (Stripe Connect)
  payoutSkipped   Boolean @default(false)
  // Step 4: Branding
  brandingSkipped Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OnboardingStep {
  ACCOUNT
  HANDLE
  PAYOUT
  BRANDING
  COMPLETED
}

// ─── Handle Reservation ──────────────────────────────────────────────────────

model HandleReservation {
  id          String     @id @default(cuid())
  handle      String     @unique
  userId      String?
  workspace   Workspace? @relation("HandleToWorkspace", fields: [workspaceId], references: [id])
  workspaceId String?    @unique
  claimedAt   DateTime   @default(now())

  @@index([handle])
  @@index([userId])
}

// ─── Storefront Theme ────────────────────────────────────────────────────────

model StorefrontTheme {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Theme config stored as JSON
  config    Json    @default("{}")
  published Boolean @default(false)

  versions ThemeVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ThemeVersion {
  id        String          @id @default(cuid())
  themeId   String
  theme     StorefrontTheme @relation(fields: [themeId], references: [id], onDelete: Cascade)
  config    Json
  version   Int
  published Boolean         @default(false)

  createdAt DateTime @default(now())

  @@unique([themeId, version])
  @@index([themeId, published])
}

// ─── Commerce Domain ─────────────────────────────────────────────────────────

model Product {
  id          String        @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  description String?       @db.Text
  price       Decimal       @db.Decimal(10, 2)
  currency    String        @default("USD")
  type        ProductType
  status      ProductStatus @default(DRAFT)
  imageUrl    String?
  
  // New pricing features
  pricingType    PricingType    @default(FIXED)
  minPrice       Decimal?       @db.Decimal(10, 2)
  suggestedPrice Decimal?       @db.Decimal(10, 2)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Sub-type relations
  course           Course?
  coachingConfig   CoachingConfig?
  membershipConfig MembershipConfig?

  enrollments  Enrollment[]
  orderItems   OrderItem[]
  prices       Price[]
  accessTokens AccessToken[]
  reviews      Review[]
  recentSales  RecentSale[]
  memberSubscriptions MemberSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
  @@index([slug])
}

enum ProductType {
  DIGITAL
  COURSE
  FREEBIE
  COACHING
  MEMBERSHIP
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PricingType {
  FIXED
  PWYW
  FREE
}

// ─── Discount Codes ────────────────────────────────────────────────────────────

model DiscountCode {
  id          String       @id @default(cuid())
  workspaceId String
  code        String       @unique
  type        DiscountType @default(PERCENTAGE)
  value       Decimal      @db.Decimal(10, 2)
  maxUses     Int?
  usedCount   Int          @default(0)
  startsAt    DateTime?
  expiresAt   DateTime?
  isActive    Boolean      @default(true)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orders    Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, isActive])
  @@index([code])
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Price {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  amount    Decimal @db.Decimal(10, 2)
  currency  String  @default("USD")
  label     String? // e.g. "Early Bird", "Full Price"

  @@index([productId])
}

// ─── Course Builder ──────────────────────────────────────────────────────────

model Course {
  id        String  @id @default(cuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  modules CourseModule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CourseModule {
  id       String @id @default(cuid())
  courseId String
  title    String
  order    Int

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, order])
}

model Lesson {
  id         String     @id @default(cuid())
  moduleId   String
  title      String
  content    String?    @db.Text
  videoUrl   String?
  order      Int
  lessonType LessonType @default(TEXT)

  module   CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress LessonProgress[]
  muxAsset MuxAsset?

  @@index([moduleId, order])
}

enum LessonType {
  TEXT
  VIDEO
  EMBED
  QUIZ
}

model MuxAsset {
  id            String         @id @default(cuid())
  lessonId      String         @unique
  lesson        Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  muxAssetId    String
  muxPlaybackId String?
  status        MuxAssetStatus @default(PREPARING)
  duration      Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

enum MuxAssetStatus {
  PREPARING
  READY
  ERROR
  DELETED
}

// ─── Coaching ────────────────────────────────────────────────────────────────

model CoachingConfig {
  id          String  @id @default(cuid())
  productId   String  @unique
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  calLink     String
  eventTypeId Int?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Membership ──────────────────────────────────────────────────────────────

model MembershipConfig {
  id          String  @id @default(cuid())
  productId   String  @unique
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  interval    PlanInterval @default(MONTH)
  stripePriceId String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PlanInterval {
  MONTH
  YEAR
}

model MemberSubscription {
  id               String             @id @default(cuid())
  userId           String
  workspaceId      String
  productId        String
  stripeSubscriptionId String          @unique
  status           SubscriptionStatus
  currentPeriodEnd DateTime
  cancelAtPeriodEnd Boolean            @default(false)
  
  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([workspaceId])
  @@index([stripeSubscriptionId])
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
}

// ─── Orders & Checkout ───────────────────────────────────────────────────────

model Order {
  id                    String        @id @default(cuid())
  workspaceId           String
  userId                String?
  isGuest               Boolean       @default(false)
  customerEmail         String?
  customerName          String?
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("USD")
  status                OrderStatus   @default(PENDING)
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?
  discountCodeId        String?
  discountCode          DiscountCode? @relation(fields: [discountCodeId], references: [id])
  
  // Affiliate attribution
  affiliateLinkId      String?
  affiliateLink        AffiliateLink? @relation(fields: [affiliateLinkId], references: [id])
  affiliateCommission  Decimal?       @db.Decimal(10, 2)

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User?     @relation(fields: [userId], references: [id])

  items        OrderItem[]
  payments     Payment[]
  accessTokens AccessToken[]
  emails       EmailLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, createdAt])
  @@index([customerEmail])
  @@index([status])
  @@index([stripeSessionId])
  @@index([userId])
  @@index([discountCodeId])
  @@index([affiliateLinkId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  FAILED
  REFUNDED
}

model Payment {
  id                    String        @id @default(cuid())
  orderId               String
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stripePaymentIntentId String?       @unique
  stripeSessionId       String?
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("USD")
  status                PaymentStatus @default(PENDING)
  applicationFee        Decimal?      @db.Decimal(10, 2)
  transferId            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([stripePaymentIntentId])
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// ─── Webhook Events (idempotency) ────────────────────────────────────────────

model WebhookEvent {
  id            String             @id @default(cuid())
  stripeEventId String             @unique
  type          String
  status        WebhookEventStatus @default(PENDING)
  processedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([stripeEventId])
  @@index([status])
}

enum WebhookEventStatus {
  PENDING
  PROCESSED
  FAILED
}

// ─── Access Tokens (fulfillment) ─────────────────────────────────────────────

model AccessToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product   @relation(fields: [productId], references: [id])
  maxUses    Int       @default(1)
  useCount   Int       @default(0)
  expiresAt  DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?

  createdAt DateTime @default(now())

  @@index([tokenHash])
  @@index([orderId])
  @@index([expiresAt])
}

// ─── Post-Purchase Email System ──────────────────────────────────────────────

model EmailLog {
  id        String      @id @default(cuid())
  orderId   String?
  order     Order?      @relation(fields: [orderId], references: [id])
  to        String
  subject   String
  template  String
  status    EmailStatus @default(SENT)
  error     String?
  openedAt  DateTime?
  clickedAt DateTime?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([status])
}

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  OPENED
  CLICKED
  FAILED
}

// ─── Enrollment ──────────────────────────────────────────────────────────────

model Enrollment {
  id        String           @id @default(cuid())
  userId    String
  productId String
  status    EnrollmentStatus @default(ACTIVE)
  
  // Certificate
  certificateUrl String?
  completedAt    DateTime?

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  progress LessonProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

enum EnrollmentStatus {
  ACTIVE
  INACTIVE
  COMPLETED
}

model LessonProgress {
  id           String  @id @default(cuid())
  enrollmentId String
  lessonId     String
  completed    Boolean @default(false)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
}

// ─── Recent Sales Social Proof ───────────────────────────────────────────────

model RecentSale {
  id          String    @id @default(cuid())
  workspaceId String
  productId   String
  buyerName   String    // Anonymized
  amount      Decimal   @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

// ─── Social Connections ──────────────────────────────────────────────────────

model SocialConnection {
  id           String   @id @default(cuid())
  workspaceId  String
  provider     String   // "tiktok", "youtube", "instagram"
  providerId   String
  accessToken  String?  @db.Text // Encrypted
  refreshToken String?  @db.Text // Encrypted
  expiresAt    DateTime?
  metadata     Json     @default("{}") // Stats like follower count

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, provider])
}

// ─── Affiliate Program ───────────────────────────────────────────────────────

model AffiliateLink {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  code        String   @unique
  commission  Decimal  @db.Decimal(5, 2) // Percentage
  isActive    Boolean  @default(true)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payouts   AffiliatePayout[]
  orders    Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([userId])
}

model AffiliatePayout {
  id              String        @id @default(cuid())
  affiliateLinkId String
  amount          Decimal       @db.Decimal(10, 2)
  status          PayoutStatus  @default(PENDING)
  paidAt          DateTime?

  affiliateLink AffiliateLink @relation(fields: [affiliateLinkId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PayoutStatus {
  PENDING
  PAID
  CANCELLED
}

// ─── Analytics ───────────────────────────────────────────────────────────────

model AnalyticsDaily {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  date        DateTime

  // Revenue
  gmv        Decimal @default(0) @db.Decimal(12, 2)
  feeAmount  Decimal @default(0) @db.Decimal(12, 2)
  netRevenue Decimal @default(0) @db.Decimal(12, 2)

  // Orders
  orderCount     Int     @default(0)
  refundCount    Int     @default(0)
  conversionRate Decimal @default(0) @db.Decimal(5, 2)

  // Visitors
  visitorCount  Int @default(0)
  pageViewCount Int @default(0)

  // Top products (JSON array of {productId, name, revenue, orders})
  topProducts Json @default("[]")

  // Email
  emailSent    Int @default(0)
  emailOpened  Int @default(0)
  emailClicked Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, date])
  @@index([workspaceId, date])
  @@index([date])
}

// ─── AI Tools ────────────────────────────────────────────────────────────────

model AiGenerationLog {
  id          String @id @default(cuid())
  workspaceId String
  userId      String
  prompt      String @db.Text
  result      String @db.Text
  model       String @default("claude-sonnet-4-20250514")
  tokensIn    Int    @default(0)
  tokensOut   Int    @default(0)
  durationMs  Int    @default(0)
  feature     String // "title", "description", "email", "lessonOutline", etc.

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([userId])
}

// ─── Email Marketing ─────────────────────────────────────────────────────────

model Subscriber {
  id          String           @id @default(cuid())
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  name        String?
  status      SubscriberStatus @default(ACTIVE)
  metadata    Json             @default("{}")

  // Unsubscribe management
  unsubscribedAt    DateTime?
  unsubscribeReason String?

  campaigns CampaignSend[]
  events    EmailEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, email])
  @@index([workspaceId, status, createdAt])
}

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
  SPAM
}

model Segment {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  description String?
  rules       Json    @default("{}") // Segment definition (e.g., {"purchased": true, "tag": "vip"})

  campaigns Campaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model Campaign {
  id          String         @id @default(cuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  subject     String
  previewText String?
  fromName    String?
  replyTo     String?
  htmlContent String         @db.Text
  plainText   String?        @db.Text
  status      CampaignStatus @default(DRAFT)
  segmentId   String?
  segment     Segment?       @relation(fields: [segmentId], references: [id])

  scheduledAt DateTime?
  sentAt      DateTime?

  sends  CampaignSend[]
  events EmailEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, status])
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELED
}

model CampaignSend {
  id           String     @id @default(cuid())
  campaignId   String
  campaign     Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriberId String
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  status       SendStatus @default(QUEUED)
  error        String?
  sentAt       DateTime?

  createdAt DateTime @default(now())

  @@unique([campaignId, subscriberId])
  @@index([campaignId])
  @@index([subscriberId])
}

enum SendStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  FAILED
}

model EmailEvent {
  id           String         @id @default(cuid())
  subscriberId String
  subscriber   Subscriber     @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  campaignId   String?
  campaign     Campaign?      @relation(fields: [campaignId], references: [id])
  type         EmailEventType
  metadata     Json           @default("{}")
  ipAddress    String?
  userAgent    String?
  linkUrl      String?

  createdAt DateTime @default(now())

  @@index([subscriberId])
  @@index([campaignId])
  @@index([type])
}

enum EmailEventType {
  OPENED
  CLICKED
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
}

// ─── Reviews ─────────────────────────────────────────────────────────────────

model Review {
  id        String       @id @default(cuid())
  productId String
  userId    String
  rating    Int // 1-5 stars
  content   String       @db.Text
  status    ReviewStatus @default(PENDING)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, status])
  @@index([userId])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id      String    @id @default(cuid())
  userId  String
  type    String // "order_placed", "new_subscriber", "review_received", etc.
  title   String
  message String?   @db.Text
  data    Json      @default("{}") // Additional context
  readAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}
