# ─── Database ───────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:pass@localhost:5432/sizzle"
DIRECT_DATABASE_URL="postgresql://user:pass@localhost:5432/sizzle"

# ─── NextAuth ──────────────────────────────────────────────────────
NEXTAUTH_SECRET="change-me-to-a-random-string"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# ─── Stripe ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_CLIENT_ID="ca_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ─── Cloudflare R2 (file storage) ──────────────────────────────────
# Note: code uses R2_SECRET_ACCESS_KEY (not R2_ACCESS_KEY_SECRET)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# ─── Email (Resend) ────────────────────────────────────────────────
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@sizzle.so"

# ─── Background Jobs (Inngest) ─────────────────────────────────────
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ─── Real-time (Pusher) ───────────────────────────────────────────
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="us2"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="us2"

# ─── AI (Anthropic Claude) ────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ─── Video (Mux) ───────────────────────────────────────────────────
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""

# ─── Rate Limiting (Upstash Redis) ─────────────────────────────────
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN=""

# ─── OAuth ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─── Cal.com ─────────────────────────────────────────────────────
CALCOM_API_KEY=""
CALCOM_WEBHOOK_SECRET=""

# ─── Social Integrations ───────────────────────────────────────────
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
YOUTUBE_API_KEY=""

# ─── Revalidation ──────────────────────────────────────────────────
REVALIDATE_SECRET=""

# ─── Encryption (AES-256 key, min 32 chars) ───────────────────────
ENCRYPTION_KEY="change-me-to-a-random-string-that-is-at-least-32-characters"

# ─── Environment ───────────────────────────────────────────────────
NODE_ENV="development"
SKIP_ENV_VALIDATION="true"
